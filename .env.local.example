# Harambee — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Supabase (Step 2) ────────────────────────────────────────────────
# Project Settings > API in your Supabase dashboard (supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# service_role key — Project Settings > API > "service_role" secret. Server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Circle Developer Controlled Wallets (Step 3) ─────────────────────
# console.circle.com > select your project > "API & Client Keys"
CIRCLE_API_KEY=your-circle-api-key
# Generated + registered by running: npm run circle:register-entity-secret
# (one-time; copy the printed value here, and keep the saved recovery/ file safe)
CIRCLE_ENTITY_SECRET=your-circle-entity-secret
# Created by running: npm run circle:create-wallet-set (one-time; copy the printed ID here)
CIRCLE_WALLET_SET_ID=your-wallet-set-id

# ── Circle Modular Wallets / Passkeys (Step 4) ────────────────────────
# console.circle.com > API & Client Keys > Create a key > type "Client Key".
# Set "Web Allowed Domain" to localhost for local dev (must match where passkeys are used).
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=your-modular-wallets-client-key
# Fixed value from Circle's Configurator page — same for everyone
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# ── Arc testnet (Steps 3, 5, 6, 6.5) ──────────────────────────────────
# Public Arc testnet RPC endpoint (also viem's built-in `arcTestnet` chain default)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Arc testnet chain ID
ARC_TESTNET_CHAIN_ID=5042002
# Arc testnet block explorer (ArcScan)
ARC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app

# ── Circle Gas Station (Step 5) ────────────────────────────────────────
# Not required in code — Circle auto-provisions a default sponsorship policy
# for testnets, and it isn't passed as a parameter in transfer calls. Kept
# here for reference in case a mainnet policy ID is ever needed.
CIRCLE_GAS_STATION_POLICY_ID=

# ── Circle Contracts / deployed addresses (Step 6, 6.5) ───────────────
# Filled in after deployment — see Step 6 output
POOL_ESCROW_CONTRACT_ADDRESS=
# Filled in after deployment — see Step 6.5 output
YIELD_VAULT_CONTRACT_ADDRESS=
# USDC (ERC-20 representation) contract address on Arc testnet
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Circle StableFX (Step 9) ───────────────────────────────────────────
# console.circle.com > StableFX > API key (may be same as CIRCLE_API_KEY depending on account setup — confirm in dashboard)
CIRCLE_STABLEFX_API_KEY=your-stablefx-api-key
