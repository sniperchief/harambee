# Harambee — environment variables (Arc mainnet)
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# PUBLIC. Everything else is server-only. Never put a secret in a NEXT_PUBLIC_
# variable. Run `npm run check:mainnet` to validate the whole configuration.

# ═══════════════════════ PUBLIC (browser) ═══════════════════════════════

# Supabase project URL + anon key (Project Settings > API). The anon key is
# designed to be public; the app itself only queries via the service role.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Circle Modular Wallets (passkeys + gasless contributions).
# console.circle.com > API & Client Keys > Create a key > type "Client Key".
# Must be a LIVE_ client key for Arc mainnet (TEST_ keys are rejected).
# Set "Web Allowed Domain" to the production domain (and localhost for dev).
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=LIVE_CLIENT_KEY:your-client-key
# Fixed value from Circle's Modular Wallets configurator.
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Optional: override the Arc mainnet explorer base (default https://explorer.arc.io)
# NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io

# ═══════════════════════ SERVER-ONLY (secrets) ══════════════════════════

# Supabase service_role key — bypasses Row Level Security. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Circle Developer-Controlled Wallets + Smart Contract Platform.
# Must be a LIVE_API_KEY for Arc mainnet (TEST_ keys are rejected).
CIRCLE_API_KEY=LIVE_API_KEY:your-circle-api-key
# Registered once per API key environment: npm run circle:register-entity-secret
CIRCLE_ENTITY_SECRET=your-circle-entity-secret
# npm run circle:create-wallet-set (one-time)
CIRCLE_WALLET_SET_ID=your-wallet-set-id
# The platform wallet on ARC that submits createPool / checkAndRelease.
# npm run circle:create-platform-wallet, then fund it with a little USDC for gas.
HARAMBEE_PLATFORM_WALLET_ID=your-platform-wallet-id

# Signs the session cookie. Random, 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Authorizes /api/cron/check-pools (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ═══════════════════════ Arc mainnet ═════════════════════════════════════
# Chain ID 5042, Circle blockchain "ARC" and the USDC address
# (0x3600000000000000000000000000000000000000) are fixed in lib/network.ts.

# Deployed PoolEscrow on Arc mainnet (npm run contracts:deploy-pool-escrow).
POOL_ESCROW_CONTRACT_ADDRESS=

# Optional: a dedicated Arc mainnet RPC for server reads (default https://rpc.mainnet.arc.io)
# ARC_RPC_URL=

# ═══════════════════════ Arc Onramp (Add funds → bank transfer) ═════════
# Circle's hosted widget for buying USDC on Arc. It uses CIRCLE_API_KEY
# unless ONRAMP_API_KEY is set (the key needs App Kits enabled in the
# console). Bank transfer needs no KYB. The widget opens as a popup, so
# ONRAMP_REFERRER_DOMAIN is only needed for the inline fallback.
# ONRAMP_API_KEY=LIVE_API_KEY:your-circle-api-key
# ONRAMP_REFERRER_DOMAIN=your.domain.com
#
# Local development: production blocks localhost, so use the sandbox with a
# TEST_ key.
# ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
# ONRAMP_API_BASE_URL=https://api-test.circle.com

# ═══════════════════════ Notes ════════════════════════════════════════════
# Gas sponsorship: contributions are sponsored by Circle Gas Station through
# the Modular Wallets paymaster. On mainnet this needs a Gas Station policy for
# Arc enabled in the Circle console; it is not configured by an env var.
#
# Local-currency display needs no env var — lib/localFx.ts uses a free public
# rate feed (open.er-api.com). It's informational only, not a payout.
