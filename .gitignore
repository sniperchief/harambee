# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# claude code session state
.claude/

# AI build-time guidance + internal build log — kept local, not published
CLAUDE.md
AGENTS.md
PROGRESS.md

# Circle entity secret recovery files — never commit
/recovery/
recovery_file_*.dat

# Hardhat build output (dev-only toolchain for yield vault time-travel tests)
/artifacts/
/cache/
/typechain-types/

# scratch/debug output
output.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
